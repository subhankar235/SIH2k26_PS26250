# Copy to .env for deployment. Replace URL placeholders with the Neon
# connection string from the dashboard; keep sslmode=require enabled.
# Apply the schema with: python -m alembic -c backend/app/db/migrations/alembic.ini upgrade head
DATABASE_URL=postgresql+psycopg://<neon-user>:<neon-password>@<neon-host>/<neon-database>?sslmode=require
POSTGRES_DB=airpower
POSTGRES_USER=airpower
POSTGRES_PASSWORD=airpower_dev
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MLFLOW_TRACKING_URI=http://mlflow:5000
FRESHNESS_THRESHOLDS={"resource":3600,"crew":3600,"availability":3600,"weather":3600,"constraint":3600}
API_KEYS={"replace-with-a-long-random-key":{"id":"local-admin","role":"admin"}}
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

{
  "name": "administrative-logistics-ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0" },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "setup": "node scripts/patch-kafkajs.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "check": "node scripts/check.js",
    "contracts": "node scripts/generate-contracts.js",
    "contracts:check": "node scripts/generate-contracts.js --check",
    "credentials": "node scripts/credentials.js",
    "viewer:credentials": "node scripts/viewer-credentials.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "scenario": "node --env-file-if-exists=.env scripts/scenario.js",
    "consumer": "node --env-file-if-exists=.env src/consumer-cli.js",
    "test:consumer:kafka": "node --test integration/consumer.test.js",
    "test:browser": "python scripts/browser-smoke.py",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "kafka:topics": "node --env-file-if-exists=.env scripts/kafka-topics.js",
    "test:kafka": "node --test integration/kafka.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "kafkajs": "2.2.4",
    "zod": "4.6.7"
  }
}
